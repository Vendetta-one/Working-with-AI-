# MemoryLane — Gemini API key
# 1. Create a key at https://aistudio.google.com/app/apikey
# 2. Copy this file to ".env.local" and paste your key below.
#
# NOTE: This prototype reads the key in server-side route handlers. For a
# production deployment, prefer a server-only variable (without the NEXT_PUBLIC_
# prefix) so the key is never shipped to the browser.
NEXT_PUBLIC_GEMINI_API_KEY=your-gemini-api-key-here
